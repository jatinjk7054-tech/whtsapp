# ─────────────────────────────────────────────────────────────────────────────
#  TEMPLATE ONLY — NAMES AND PLACEHOLDERS. NEVER A REAL VALUE.
#
#  A secret committed here is a secret published. Vite/PM2/Vercel do not
#  distinguish, and git keeps it forever. This file previously held the real
#  ADMIN_*, WHATSAPP_MASTER_* and WHATSAPP_VERIFY_TOKEN values; those are now
#  treated as public and MUST be rotated.
#
#  Rules:  https://beingsevak.org  ->  docs/security/SECRETS-MANAGEMENT.md
#  Audit:  npm run security:check
# ─────────────────────────────────────────────────────────────────────────────

# ──── JWT (for Express auth) ────
# Use a long random value, and a DIFFERENT one per environment. One secret for
# every subsystem means a single leak compromises all of them.
JWT_SECRET=your-jwt-secret

# ──── Server ────
PORT=5000

# ──── Admin break-glass key ────
# Gates /api/envadmin, which can read and write every project's .env and
# restart services. When unset the endpoint FAILS OPEN unless the code is
# fixed to fail closed — see docs/security/SECURITY.md P0-C. Keep it unset
# outside development.
# ENV_ADMIN_KEY=your-break-glass-admin-key

# ──── WhatsApp Master Admin ────
# Master login bypasses all checks. Use this to create/manage users.
WHATSAPP_MASTER_EMAIL=your-master-email@example.com
WHATSAPP_MASTER_PASSWORD=your-master-password

# ──── WhatsApp Cloud API (Meta) ────
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_API_VERSION=v23.0
WHATSAPP_WABA_ID=your-waba-id
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token

# ──── WhatsApp Templates ────
WHATSAPP_TEMPLATE_NAME=bsct_receipt

# ──── Admin Seed ────
# Bootstraps the first super_admin. Change both before the first deploy, and
# note that this file previously shipped the real values — rotate them.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password

# ──── Database ────
# Prefer a secret manager or a file outside the repo. A DATABASE_URL with an
# inline password is fine here ONLY as a placeholder.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME


# ──── AI Payment Scraper (scrapper/ Android app) ────
# Shared key the 3 phones send as `X-Scraper-Key`. Used by /api/accounts/scraper/*.
# SCRAPER_DEVICE_KEY=change-me-strong-device-secret

# OCR_SPACE_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=            # Aadhaar photo OCR (parse-photo scraping). https://aistudio.google.com/apikey
# GEMINI_MODEL=gemini-3.8-flash
# CALENDARIFIC_API_KEY=      # India festivals + worldwide/UN observances for the Event Head calendar. https://calendarific.com
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_CLIENT_EMAIL=
# IMAP_ENABLED=false
# RAZORPAY_ENABLED=false
# PAYTM_ENABLED=false

# ──── Optional: Live Google Sheets report (quiz results) ────
# GOOGLE_SHEET_ID=your-spreadsheet-id
# GOOGLE_SHEET_NAME=Sheet1
# For deployment, pass the service account JSON inline (prefer base64, e.g.:
#   $env:GOOGLE_SERVICE_ACCOUNT = [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
# raw inline JSON also works:
# GOOGLE_SERVICE_ACCOUNT={"type":"service_account",...}
# For local dev you may instead use a file path:
# GOOGLE_SERVICE_ACCOUNT=credentials/service-account.json

# ──── Backup Configuration ────
# AWS Backup
BACKUP_SCHEDULE=cron(0 2 */2 * ? *)          # Every 2 days at 02:00 UTC
BACKUP_RETENTION_DAYS=28                     # Standard retention (28 days)
BACKUP_MONTHLY_RETENTION_DAYS=365            # Monthly long-term retention
BACKUP_S3_BUCKET=ucs-crm-backups
BACKUP_S3_PREFIX=aws-rds
RDS_INSTANCE_IDENTIFIER=ucs-crm-db
AWS_REGION=ap-south-1

# ──── Local development database access ────
# Lets the backend run on your machine against the real AWS database: on boot it
# authorizes your current public IP on the RDS security group (port 5432) and on
# shutdown it removes that rule. Every rule it makes is tagged "ucs-local-dev:"
# and leftovers are swept on the next boot.
#
# Set to true ONLY for local runs. It is ignored on Vercel and on the EC2/PM2
# server. Your AWS key also needs ec2:AuthorizeSecurityGroupIngress and
# ec2:RevokeSecurityGroupIngress, not just the read-only RDS/CloudWatch perms.
# Prefer the SSH tunnel (start-local-db-tunnel.ps1) if you would rather change
# nothing in AWS at all.
LOCAL_DB_ACCESS=false
# How long a leftover rule may sit before the next boot removes it.
LOCAL_DB_ACCESS_RULE_TTL_HOURS=12
# LOCAL_DB_ACCESS_REGION=ap-south-1        # default: AWS_REGION, or parsed from DATABASE_URL
# LOCAL_DB_ACCESS_PORT=5432                # default: the port in DATABASE_URL, else 5432
# LOCAL_DB_ACCESS_IP_URL=https://checkip.amazonaws.com

# ──── Dual-Account S3 (head + upstream) ────
# Head = your dev account (default target for db.storage.from('bucket'))
HEAD_AWS_ACCESS_KEY_ID=your-head-access-key
HEAD_AWS_SECRET_ACCESS_KEY=your-head-secret-key
HEAD_S3_BUCKET=ucs-crm-head-uploads
HEAD_S3_REGION=ap-south-1

# Upstream = production account (select via db.storage.from('upstream', 'bucket'))
UPSTREAM_AWS_ACCESS_KEY_ID=your-upstream-access-key
UPSTREAM_AWS_SECRET_ACCESS_KEY=your-upstream-secret-key
UPSTREAM_S3_BUCKET=ucs-crm-uploads-mumbai
UPSTREAM_S3_REGION=ap-south-1

# Legacy single-account fallback (used when HEAD_* not configured)
# S3_BUCKET=ucs-crm-uploads-mumbai
# S3_REGION=ap-south-1

# Lambda pg-dump (optional)
# RDS_PASSWORD=your-rds-password              # Stored in Secrets Manager, not here
# PG_DUMP_PATH=/opt/pg_dump/bin/pg_dump

# In-process memory watchdog (backend self-restarts before OOM on a 2GB box)
# MEM_WATCHDOG_MB=900             # restart if RSS stays above this for GRACE
# MEM_WATCHDOG_GRACE_MS=20000     # sustained-overrun window before SIGTERM
# MEM_WATCHDOG_INTERVAL_MS=5000   # RSS poll interval

# ──── Sevak Library ────
# The sevak-library module reads/writes the original Supabase project (schema
# migrated to RDS, but live reads still go to Supabase until cut-over). The
# migration script (scripts/migrate-sevak-library.mjs) requires both.
SEVAK_SUPABASE_URL=https://<project>.supabase.co
SEVAK_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the standalone Sevak Library app, used in payment/renewal email
# buttons. Defaults to https://api.beingsevak.org/sevak-library
# SEVAK_APP_URL=https://api.beingsevak.org/sevak-library
