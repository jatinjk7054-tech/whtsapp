.vercel

# Secrets. This package must be safe to clone on its own, so do not rely on the
# repository-root .gitignore — cover every environment variant here.
.env
.env.*
!.env.example
*.env

# Generated report output. These are read-only audits of production and contain
# real employee names and performance figures, so they are review artefacts, not
# source. Keep them local (or on the server) and out of the repository.
/reports/

# Calendarific disk cache (one API call per country+year). Never ship or commit.
/.cache/

# Node
node_modules/

# Logs
*.log
npm-debug.log*

# Uploads — donor paperwork, bank statements, payment screenshots. Must never
# be committed; see docs/security/SECURITY.md P1-A.
/uploads/
