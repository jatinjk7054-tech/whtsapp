PORT=4000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=jatin
DB_USER=postgres
DB_PASSWORD=postgres

# Production allow-list of browser origins allowed to call this API.
# Comma-separated. Dev me zaroorat nahi: NODE_ENV !== production hone par
# localhost / 127.0.0.1 ke kisi bhi port (5173, 5174, ...) khud accept ho jate hain.
CORS_ORIGIN=http://localhost:5173

# Auth -----------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=12h
# Credentials used to seed the first admin when the staff table is empty.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please
SEED_ADMIN_NAME=Admin

# WhatsApp Business Cloud API ------------------------------------------------
# Phone Number ID of the business number that receives customer messages.
WHATSAPP_PHONE_NUMBER_ID=
# Permanent (System User) or temporary access token for the WABA.
WHATSAPP_ACCESS_TOKEN=
# App Secret from Meta developer dashboard, used to verify X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
# Value you choose and paste into the webhook "Verify token" field in Meta.
WHATSAPP_VERIFY_TOKEN=
# Graph API version. Override only when you need a newer endpoint version.
WHATSAPP_GRAPH_VERSION=v21.0
# Automatic first-message reply
WHATSAPP_AUTO_REPLY_ENABLED=true
WHATSAPP_AUTO_REPLY_TEXT=Namaste 🙏\nBeing Sevak Charitable Trust se sampark karne ke liye dhanyavaad.\nKripya apna naam aur apni query bhejein. Hamari team jald aapse sampark karegi.

# WhatsApp Business Calling (voice) -----------------------------------------
# Off by default. Turn on only after Meta has enabled Calling on the number and
# the app is subscribed to the "calls" webhook field. When off, no call button
# is shown and the /calls API stays disabled.
WHATSAPP_CALLING_ENABLED=false
# Optional JSON array of ICE servers for browser WebRTC. The default is a public
# STUN server; add a TURN relay if customers sit behind symmetric NAT. Anything
# here is handed to signed-in staff's browsers, so avoid long-lived TURN secrets.
# CALLING_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

# Development-only example agent accounts. Change these before real use.
SEED_AGENT1_NAME=Agent 1
SEED_AGENT1_EMAIL=agent1@example.com
SEED_AGENT1_PASSWORD=Agent1@12345
SEED_AGENT2_NAME=Agent 2
SEED_AGENT2_EMAIL=agent2@example.com
SEED_AGENT2_PASSWORD=Agent2@12345

# Optional: WhatsApp Business Account ID (Meta App Dashboard -> WhatsApp -> API Setup).
# If omitted, the backend learns it from the webhook entry id on the first inbound message.
WHATSAPP_WABA_ID=
